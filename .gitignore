# Repository ignore rules for generated ROS, Python, flight-controller, and local-tool files.

# ROS 2 / colcon build outputs and runtime state
build/
install/
log/
.colcon/
.ros/
rosbag2_*/
*.bag
*.bag.active
*.db3
*.mcap

# Python bytecode, test caches, environments, and packaging outputs
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
*.egg-info/
.eggs/
dist/
venv/
.venv/
env/
ENV/
.ipynb_checkpoints/

# ArduPilot SITL, MAVProxy, MAVLink, and flight-recording outputs
logs/
terrain/
eeprom.bin
*.tlog
*.tlog.raw
*.BIN
LASTLOG.TXT
*.parm
*.ulg
*.stg
*.waypoints
*.rally
*.fence
*_log_*.csv
.mavproxy_history

# Generic logs, crash dumps, and temporary files
*.log
*.log.*
*.pid
*.pid.lock
core
core.*
*.stackdump
*.tmp
*.temp
*.cache
*.bak
*.orig
*.rej
*~

# Deep Copilot local state (cover common historical spellings)
.deep-copilot/
.deepcopilot/
deep-copilot/
deepcopilot/

# Local agent instructions and installer artifacts
/AGENTS.md
/fishros

# Agent-specific scratch files and generated evidence
/agent/codex/
/agent/grok/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Compiled binaries and native build by-products
*.exe
*.out
*.app
*.o
*.obj
*.a
*.dylib
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json

# Generated documentation
docs/_build/
site/

# Operating-system metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
