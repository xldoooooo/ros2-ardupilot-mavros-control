# ROS and workspace used by the reviewed systemd example.
ROS_DISTRO=humble
ONBOARD_WORKSPACE=/home/onboard/ros2-ardupilot-mavros-control

# Matching domain IDs on UAV and ground station select the same trusted ROS graph.
ROS_DOMAIN_ID=42

# Humble uses ROS_LOCALHOST_ONLY; 0 keeps default subnet multicast discovery enabled.
ROS_LOCALHOST_ONLY=0

# ROS_AUTOMATIC_DISCOVERY_RANGE/ROS_STATIC_PEERS were introduced after Humble.
# If multicast is unreliable, validate a Fast DDS XML profile on both endpoints.
