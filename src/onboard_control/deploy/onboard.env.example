# 安装器会替换这两个占位符；现场文件后续由运维人员维护且不会被覆盖。
ONBOARD_ROS_DISTRO=ONBOARD_ROS_DISTRO_VALUE
ONBOARD_WORKSPACE=ONBOARD_WORKSPACE_PATH

# When more than one serial candidate exists, set the flight controller only after
# verifying the aircraft wiring. Prefer a stable /dev/serial/by-id path when available.
# MAVROS_FCU_DEVICE=/dev/serial/by-id/<verified-flight-controller>

# Pin package-owning overlays only after confirming the deployed workspaces.
# ODIN_OVERLAY_SETUP=/home/<user>/<odin-workspace>/install/setup.bash
# EXTNAV_OVERLAY_SETUP=/home/<user>/<extnav-workspace>/install/setup.bash

# Domain 0 matches the ROS default used by separately launched MAVROS/Odin/extnav.
# Change this to 42 only when the same environment is loaded by all four UAV processes
# and by the ground station before they start; changing a running shell cannot migrate nodes.
ROS_DOMAIN_ID=0

# 启动器在 Humble 使用该变量，在 Jazzy 自动改用下面的 discovery range。
ROS_LOCALHOST_ONLY=0

# Jazzy 正式机载链使用同网段发现；Humble 启动时会自动忽略该变量。
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
