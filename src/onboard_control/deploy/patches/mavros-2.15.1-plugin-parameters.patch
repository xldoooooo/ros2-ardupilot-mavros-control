From d9b38f666eff364e0f6fa0fc1d7c13171d82bbc4 Mon Sep 17 00:00:00 2001
From: Vladimir Ermakov <vooon341@gmail.com>
Date: Sun, 27 Sep 2026 10:38:25 +0200
Subject: [PATCH] mavros: re-apply process parameter sources to plugin
 sub-nodes

Since 63f7392 plugin nodes are created with use_global_arguments(false) so
that a component container's `-r __node:=<container>` remap rule does not
rename every plugin. But NodeOptions has no remap-only switch: global
arguments also carry the process parameter sources (--params-file / -p),
so every `/**/<plugin>:` section of apm_config.yaml / px4_config.yaml was
silently dropped and plugins fell back to their compiled-in defaults.

Resolve the process parameter overrides for the plugin's fully-qualified
name and hand them to the node as local parameter_overrides, which are
unaffected by use_global_arguments(false) and carry no remap rules. This
mirrors rclcpp's resolve_parameter_overrides() precedence: global sources
first, then the caller-provided overrides.

Fixes #2294.

Signed-off-by: Vladimir Ermakov <vooon341@gmail.com>
---
 mavros/CMakeLists.txt               |  12 +++
 mavros/package.xml                  |   1 +
 mavros/src/lib/plugin.cpp           |  41 ++++++++++
 mavros/test/test_plugin_params.cpp  | 117 ++++++++++++++++++++++++++++
 mavros/test/test_plugin_params.yaml |   6 ++
 5 files changed, 177 insertions(+)
 create mode 100644 mavros/test/test_plugin_params.cpp
 create mode 100644 mavros/test/test_plugin_params.yaml

diff --git a/mavros/CMakeLists.txt b/mavros/CMakeLists.txt
index 8e69fa094..131de902e 100644
--- a/mavros/CMakeLists.txt
+++ b/mavros/CMakeLists.txt
@@ -21,6 +21,7 @@ find_package(ament_cmake REQUIRED)
 find_package(ament_cmake_python REQUIRED)
 
 # find mavros dependencies
+find_package(rcl REQUIRED)
 find_package(rclcpp REQUIRED)
 find_package(rclcpp_components REQUIRED)
 find_package(pluginlib REQUIRED)
@@ -131,6 +132,7 @@ target_link_libraries(mavros PUBLIC
   ${diagnostic_msgs_TARGETS}
   diagnostic_updater::diagnostic_updater
   pluginlib::pluginlib
+  rcl::rcl
   rclcpp::rclcpp
   rclcpp_components::component
   rclcpp_components::component_manager
@@ -336,6 +338,16 @@ if(BUILD_TESTING)
     ${mavros_msgs_TARGETS}
   )
 
+  # Regression test for #2294: plugin sub-nodes must apply process params files.
+  ament_add_gtest(mavros-plugin-params-test test/test_plugin_params.cpp)
+  target_link_libraries(mavros-plugin-params-test
+    mavros
+    ${mavros_msgs_TARGETS}
+  )
+  target_compile_definitions(mavros-plugin-params-test PRIVATE
+    TEST_PLUGIN_PARAMS_YAML="${CMAKE_CURRENT_SOURCE_DIR}/test/test_plugin_params.yaml"
+  )
+
   ament_add_pytest_test(mavros_py_test test/mavros_py
     PYTHON_EXECUTABLE "${PYTHON_EXECUTABLE}"
     APPEND_ENV PYTHONPATH=${CMAKE_CURRENT_BINARY_DIR}
