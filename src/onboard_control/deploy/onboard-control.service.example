# 四组件生产模板；安装器替换用户和工作区，占位符不得原样部署。
[Unit]
Description=ROS 2 ArduPilot onboard control service
# ROS wall timers must not be created before the first boot-time clock sync.
Wants=network-online.target systemd-time-wait-sync.service
After=network-online.target time-sync.target

[Service]
Type=simple
User=ONBOARD_USER
Group=ONBOARD_USER
SupplementaryGroups=dialout
WorkingDirectory=ONBOARD_WORKSPACE_PATH
EnvironmentFile=-/etc/ros2-ardupilot/onboard.env
Environment=HOME=ONBOARD_HOME_PATH
Environment=ONBOARD_WORKSPACE=ONBOARD_WORKSPACE_PATH
ExecStart=/bin/bash -lc 'exec "${ONBOARD_WORKSPACE}/start_onboard_control.sh"'
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
