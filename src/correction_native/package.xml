<?xml version="1.0"?>
<!-- Native Odin ingress and UVC/AprilTag hot paths; Python owns calibration transactions. -->
<package format="3">
  <name>correction_native</name>
  <version>2.0.0</version>
  <description>Native data plane for the Odin-Tag correction service.</description>
  <maintainer email="xld@todo.todo">xld</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>pybind11_vendor</build_depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>python3-opencv</depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
