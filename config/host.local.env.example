# Optional host-specific settings for ground launchers and build scripts.
# Copy to host.local.env; this example is never loaded directly.

# Match the aircraft profile's ROS_DOMAIN_ID before connecting to hardware.
# Domain 231 is reserved for local simulation.
GROUND_STATION_HARDWARE_DOMAIN_ID=0

# Default GPS origin shown before a full hardware connection: latitude,longitude,altitude(m).
# The operator can still change it in the GUI before connecting.
GROUND_STATION_GPS_ORIGIN=30.2489634,120.2052342,488.0
