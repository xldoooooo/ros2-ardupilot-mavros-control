<?xml version="1.0"?>
<!-- 生产 extnav_bridge 元数据模板；缺少 correction_interfaces 时源码仍 identity 透传。 -->
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>extnav_bridge</name>
  <version>1.0.0</version>
  <description>Odin to MAVROS bridge with atomic optional planar correction.</description>
  <maintainer email="2817038081@qq.com">xld</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>correction_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>rclpy</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
