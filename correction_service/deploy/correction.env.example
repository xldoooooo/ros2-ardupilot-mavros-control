# odin-correction.service 的可选逐机覆盖；systemd EnvironmentFile 不使用 shell export。
ROS_DOMAIN_ID=0
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
# 默认值由安装后的 unit 提供；仅在现场需要外置配置/不同相机 overlay 时取消注释。
# CORRECTION_CONFIG_DIR=/home/nvidia/ros2-ardupilot-sitl-hardware/correction_service/config
# CORRECTION_CAMERA_OVERLAY_SETUP=/home/nvidia/vins_odin_calib/camera_ws/install/setup.bash
