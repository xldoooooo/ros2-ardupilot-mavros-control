# 独立 Odin 修正服务；不要添加 Requires/PartOf=飞控，失败不得停止 extnav/MAVROS。
[Unit]
Description=Independent AprilTag to Odin correction service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ONBOARD_USER
Group=ONBOARD_USER
SupplementaryGroups=video
WorkingDirectory=ONBOARD_WORKSPACE_PATH/correction_service
Environment=HOME=ONBOARD_HOME_PATH
Environment=ROS_DOMAIN_ID=0
Environment=ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
Environment=CORRECTION_CONFIG_DIR=ONBOARD_WORKSPACE_PATH/correction_service/config
EnvironmentFile=-/etc/ros2-ardupilot/correction.env
ExecStart=ONBOARD_WORKSPACE_PATH/scripts/onboard/start_onboard_correction.sh
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillSignal=SIGINT
KillMode=control-group

[Install]
WantedBy=multi-user.target
