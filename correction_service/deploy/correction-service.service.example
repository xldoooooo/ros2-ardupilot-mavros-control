# 独立 Odin 修正服务；不要添加 Requires/PartOf=飞控，失败不得停止 extnav/MAVROS。
[Unit]
Description=Independent AprilTag to Odin correction service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ONBOARD_USER
Group=ONBOARD_USER
SupplementaryGroups=video
WorkingDirectory=ONBOARD_WORKSPACE_PATH/correction_service
Environment=HOME=ONBOARD_HOME_PATH
Environment=ROS_DOMAIN_ID=0
Environment=ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
Environment=CORRECTION_CONFIG_DIR=ONBOARD_WORKSPACE_PATH/correction_service/config
Environment=CORRECTION_CAMERA_OVERLAY_SETUP=CAMERA_OVERLAY_PATH
EnvironmentFile=-/etc/ros2-ardupilot/correction.env
ExecStart=/bin/bash --noprofile --norc -c 'set -e; source /opt/ros/jazzy/setup.bash; source ONBOARD_WORKSPACE_PATH/install/setup.bash; source "${CORRECTION_CAMERA_OVERLAY_SETUP}"; exec ros2 run correction_service correction_node --ros-args -p "config_dir:=${CORRECTION_CONFIG_DIR}"'
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillSignal=SIGINT
KillMode=control-group

[Install]
WantedBy=multi-user.target
