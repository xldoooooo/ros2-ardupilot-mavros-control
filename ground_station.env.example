# Ground hardware connections are fixed to the UAV's existing DDS domain 0.
# The GUI creates local simulation in domain 231 with localhost-only discovery, then
# rebuilds its ROS context on domain 0 when the operator connects real hardware.
export ROS_DOMAIN_ID=0
export ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

# If multicast discovery is unreliable, set the UAV companion-computer address.
# export ROS_STATIC_PEERS=192.168.1.10
