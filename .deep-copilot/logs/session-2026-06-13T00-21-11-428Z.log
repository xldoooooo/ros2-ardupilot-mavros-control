[2026-06-13T00:35:35.327Z] [TOOL_CALL] {"id":"call_00_UN8caaDkJvfYixVjllZk3439","name":"str_replace_in_file","args":{"new_string":"    def _compute_transformed(self):\n        \"\"\"提取最新消息，应用 Odin→FCU 变换 + FLU→ENU，返回 (p, v, q, stamp)\"\"\"\n        if self.latest_msg is None:\n            return None\n\n        stamp = self.latest_msg.header.stamp\n        if stamp.sec == 0 and stamp.nanosec == 0:\n            stamp = self.get_clock().now().to_msg()\n\n        if isinstance(self.latest_msg, Odometry):\n            p = self.latest_msg.pose.pose.position\n            q = self.latest_msg.pose.pose.orientation\n            v = self.latest_msg.twist.twist.linear\n            a = self.latest_msg.twist.twist.angular\n            px, py, pz = p.x, p.y, p.z\n            qx, qy, qz, qw = q.x, q.y, q.z, q.w\n            vx, vy, vz = v.x, v.y, v.z\n            wx, wy, wz = a.x, a.y, a.z\n        else:\n            p = self.latest_msg.pose.position\n            q = self.latest_msg.pose.orientation\n            px, py, pz = p.x, p.y, p.z\n            qx, qy, qz, qw = q.x, q.y, q.z, q.w\n            vx, vy, vz = 0.0, 0.0, 0.0\n            wx, wy, wz = 0.0, 0.0, 0.0\n\n        p_fcu, v_fcu, q_fcu = self._apply_transform(\n            px, py, pz, vx, vy, vz, qx, qy, qz, qw, wx, wy, wz)\n\n        # FLU → ENU\n        p_enu = np.array([-p_fcu[1], p_fcu[0], p_fcu[2]])\n        v_enu = np.array([-v_fcu[1], v_fcu[0], v_fcu[2]])\n        q_flu_to_enu = euler_to_quaternion(0.0, 0.0, math.pi / 2.0)\n        qi = (-q_flu_to_enu[0], -q_flu_to_enu[1], -q_flu_to_enu[2], q_flu_to_enu[3])\n        q_enu = multiply_quaternions(\n            multiply_quaternions(q_flu_to_enu, q_fcu), qi)\n\n        return p_enu, v_enu, q_enu, stamp\n\n    def vision_timer_callback(self):\n        r = self._compute_transformed()\n        if r is None:\n            return\n        p_enu, v_enu, q_enu, stamp = r\n\n        vis_out = PoseStamped()\n        vis_out.header.stamp = stamp\n        vis_out.header.frame_id = 'map'\n        vis_out.pose.position.x = p_enu[0]\n        vis_out.pose.position.y = p_enu[1]\n        vis_out.pose.position.z = p_enu[2]\n        vis_out.pose.orientation.x = q_enu[0]\n        vis_out.pose.orientation.y = q_enu[1]\n        vis_out.pose.orientation.z = q_enu[2]\n        vis_out.pose.orientation.w = q_enu[3]\n        self.vis_pub.publish(vis_out)\n\n    def ctrl_timer_callback(self):\n        r = self._compute_transformed()\n        if r is None:\n            return\n        p_enu, v_enu, q_enu, stamp = r\n\n        pose_out = PoseStamped()\n        pose_out.header.stamp = stamp\n        pose_out.header.frame_id = 'map'\n        pose_out.pose.position.x = p_enu[0]\n        pose_out.pose.position.y = p_enu[1]\n        pose_out.pose.position.z = p_enu[2]\n        pose_out.pose.orientation.x = q_enu[0]\n        pose_out.pose.orientation.y = q_enu[1]\n        pose_out.pose.orientation.z = q_enu[2]\n        pose_out.pose.orientation.w = q_enu[3]\n        self.pose_fcu_pub.publish(pose_out)\n\n        vel_out = TwistStamped()\n        vel_out.header.stamp = stamp\n        vel_out.header.frame_id = 'map'\n        vel_out.twist.linear.x = v_enu[0]\n        vel_out.twist.linear.y = v_enu[1]\n        vel_out.twist.linear.z = v_enu[2]\n        self.vel_fcu_pub.publish(vel_out)","old_string":"    def timer_callback(self):\n        if self.latest_msg is None:\n            return\n\n        stamp = self.latest_msg.header.stamp\n        if stamp.sec == 0 and stamp.nanosec == 0:\n            stamp = self.get_clock().now().to_msg()\n\n        # 提取 Odin 坐标系数据\n        if isinstance(self.latest_msg, Odometry):\n            p = self.latest_msg.pose.pose.position\n            q = self.latest_msg.pose.pose.orientation\n            v = self.latest_msg.twist.twist.linear\n            a = self.latest_msg.twist.twist.angular\n            px, py, pz = p.x, p.y, p.z\n            qx, qy, qz, qw = q.x, q.y, q.z, q.w\n            vx, vy, vz = v.x, v.y, v.z\n            wx, wy, wz = a.x, a.y, a.z\n        else:\n            p = self.latest_msg.pose.position\n            q = self.latest_msg.pose.orientation\n            px, py, pz = p.x, p.y, p.z\n            qx, qy, qz, qw = q.x, q.y, q.z, q.w\n            vx, vy, vz = 0.0, 0.0, 0.0\n            wx, wy, wz = 0.0, 0.0, 0.0\n\n        # 应用 Odin→FCU 变换\n        p_fcu, v_fcu, q_fcu = self._apply_transform(\n            px, py, pz, vx, vy, vz, qx, qy, qz, qw, wx, wy, wz)\n\n        # ---- 发布 /mavros/vision_pose/pose (送飞控 EKF) ----\n        vis_out = PoseStamped()\n        vis_out.header.stamp = stamp\n        vis_out.header.frame_id = 'map'\n        vis_out.pose.position.x = p_fcu[0]\n        vis_out.pose.position.y = p_fcu[1]\n        vis_out.pose.position.z = p_fcu[2]\n        vis_out.pose.orientation.x = q_fcu[0]\n        vis_out.pose.orientation.y = q_fcu[1]\n        vis_out.pose.orientation.z = q_fcu[2]\n        vis_out.pose.orientation.w = q_fcu[3]\n        self.vis_pub.publish(vis_out)\n\n        # ---- 发布 /extnav/pose_fcu (供控制器) ----\n        pose_out = PoseStamped()\n        pose_out.header.stamp = stamp\n        pose_out.header.frame_id = 'map'\n        pose_out.pose = vis_out.pose\n        self.pose_fcu_pub.publish(pose_out)\n\n        # ---- 发布 /extnav/velocity_fcu (供控制器) ----\n        vel_out = TwistStamped()\n        vel_out.header.stamp = stamp\n        vel_out.header.frame_id = 'map'\n        vel_out.twist.linear.x = v_fcu[0]\n        vel_out.twist.linear.y = v_fcu[1]\n        vel_out.twist.linear.z = v_fcu[2]\n        self.vel_fcu_pub.publish(vel_out)","path":"/home/xld/vrpn_mavros/src/extnav_bridge/extnav_bridge/extnav_to_vision_pose.py"}}
