[2026-06-13T00:41:08.501Z] [TOOL_RESULT] {"id":"call_00_PfB5BEFPl018N4SCh5c20769","name":"read_file","elapsed_ms":1,"ok":true,"output":"#!/bin/bash\n\n# 启动apm.launch\nros2 launch mavros apm.launch fcu_url:=/dev/ttyTHS1:460800 &\nsleep 2\n# roslaunch livox_ros_driver2 msg_MID360.launch &\n# sleep 0.5\n# roslaunch fast_lio mapping_mid360.launch &\n\nsource ~/ws/install/setup.bash \nros2 launch odin_ros_driver  odin1_ros2.launch.py &\nsleep 2\n\necho \"odin start success!\"\nsleep 0.5\n\nsource ~/vrpn_mavros/install/setup.bash\n\n# Odin 在飞控 ENU 坐标系下的位姿 (需根据实际标定手动设置)\n# odin_x/y/z:           Odin 原点在 FCU 下的位置 (米)\n# odin_roll/pitch/yaw:  Odin 坐标轴相对 FCU 的 ZYX 欧拉角 (度)\n# 同时发布: /mavros/vision_pose/pose (送飞控EKF), /extnav/pose_fcu + /extnav/velocity_fcu (供控制器)\nros2 run extnav_bridge extnav_to_vision_pose --ros-args \\\n  -p input_type:=odometry \\\n  -p rate_hz:=100.0 \\\n  -p odin_roll_deg:=0.0 \\\n  -p odin_pitch_deg:=0.0 \\\n  -p odin_yaw_deg:=0.0 \\\n  -p odin_x:=0.0 \\\n  -p odin_y:=0.0 \\\n  -p odin_z:=0.0 &\necho \"extnav bridge (Odin→FCU) start success!\"\nsleep 0.2\n\n# 定义一个函数来调用服务，使代码简洁\nset_rate() {\n    local msg_id=$1\n    local rate=$2\n    ros2 service call /mavros/set_message_interval mavros_msgs/srv/MessageInterval \"{message_id: $msg_id, message_rate: $rate}\"\n}\n\n# 提高 local position (ID 32) 频率\nset_rate 32 100\n\n# 提高 imu/data (ID 31) 频率\nset_rate 31 100\n\n# 提高 imu/data_raw (ID 105) 频率\nset_rate 105 100\n\necho \"=========================================\"\necho \"Message intervals set successfully!\"\necho \"=========================================\"\necho \"\"\n\n\nwait\nexit 0\n"}
