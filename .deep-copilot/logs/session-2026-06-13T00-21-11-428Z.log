[2026-06-13T01:37:40.412Z] [TOOL_CALL] {"id":"call_00_q23SfyG8gjxH4lIbaOzm6815","name":"str_replace_in_file","args":{"new_string":"    def _apply_transform(self, px, py, pz, vx, vy, vz, qx, qy, qz, qw, wx, wy, wz):\n        \"\"\"将 Odin 坐标系下的位姿/速度/姿态变换到 FCU 坐标系\n\n        姿态: q_fcu = q_R * q_odin * inv(q_R)\n        位置: p_fcu = p_odin + T - R_fcu @ T\n        速度: v_fcu = v_odin - R_fcu @ (Omega × T)\n        \"\"\"\n        T = np.array([self.tx, self.ty, self.tz])\n\n        # ---- 姿态: q_fcu = q_R * q_odin * inv(q_R) ----\n        q_odin = (qx, qy, qz, qw)\n        q_fcu = multiply_quaternions(\n            multiply_quaternions(self.q_R, q_odin), self.q_R_inv)\n\n        # ---- 当前机身旋转矩阵 (从 q_fcu 实时构造) ----\n        R_fcu = quaternion_to_rotation_matrix(q_fcu)\n\n        # ---- 位置: p_fcu = p_odin + T - R_fcu @ T ----\n        p_odin = np.array([px, py, pz])\n        p_fcu = p_odin + T - R_fcu @ T\n\n        # ---- 速度: v_fcu = v_odin - R_fcu @ (omega_odin × T) ----\n        v_odin = np.array([vx, vy, vz])\n        omega_odin = np.array([wx, wy, wz])\n        lever_arm_vel = np.cross(omega_odin, T)\n        v_fcu = v_odin - R_fcu @ lever_arm_vel\n\n        return p_fcu, v_fcu, q_fcu","old_string":"    def _apply_transform(self, px, py, pz, vx, vy, vz, qx, qy, qz, qw, wx, wy, wz):\n        \"\"\"将 Odin 坐标系下的位姿/速度/姿态变换到 FCU 坐标系\n\n        姿态 (先算): q_fcu = q_R * q_odin * inv(q_R)\n        位置:       p_fcu = p_odin + T - R_fcu @ T\n        速度:       v_fcu = v_odin - R_fcu @ (Omega × T)\n        \"\"\"\n        T = np.array([self.tx, self.ty, self.tz])\n\n        # ---- 姿态: q_fcu = q_odin  ----\n        q_fcu = (qx, qy, qz, qw)\n\n        # ---- 当前机身旋转矩阵 (从 q_fcu 实时构造) ----\n        R_fcu = quaternion_to_rotation_matrix(q_fcu)\n\n        # ---- 位置: p_fcu = p_odin + T - R_fcu @ T ----\n        p_odin = np.array([px, py, pz])\n        p_fcu = p_odin + T - R_fcu @ T\n\n        # ---- 速度: v_fcu = v_odin - R_mount @ R_odin @ (omega_odin × R_mount^T @ T) ----\n        v_odin = np.array([vx, vy, vz])\n        omega_odin = np.array([wx, wy, wz])\n        lever_arm_vel = np.cross(omega_odin, T)\n        v_fcu = v_odin -  R_fcu @ lever_arm_vel\n\n        return p_fcu, v_fcu, q_fcu","path":"/home/xld/vrpn_mavros/src/extnav_bridge/extnav_bridge/extnav_to_vision_pose.py"}}
