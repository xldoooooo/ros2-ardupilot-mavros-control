# systemd unit for the reviewed onboard four-component launcher.
[Unit]
Description=ROS 2 ArduPilot onboard flight stack
# MAVROS must start after the first wall-clock synchronization.  Starting before
# this point lets the several-minute boot-time clock step stall its ROS timers.
Wants=network-online.target systemd-time-wait-sync.service
After=network-online.target time-sync.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=xld
Group=xld
WorkingDirectory=/home/onboard/ros2-ardupilot-mavros-control
Environment=HOME=/home/xld
Environment=ONBOARD_WORKSPACE=/home/onboard/ros2-ardupilot-mavros-control
Environment=ROS_DOMAIN_ID=0
Environment=ROS_LOCALHOST_ONLY=0
ExecStart=/usr/bin/bash --noprofile --norc -c 'set +u; source /opt/ros/humble/setup.bash; source /home/onboard/ros2-ardupilot-mavros-control/install/setup.bash; source /home/xld/ws/install/setup.bash; source /home/xld/vrpn_mavros/install/setup.bash; set -u; exec /usr/bin/bash /home/onboard/ros2-ardupilot-mavros-control/start_drone_all.sh'
Restart=on-failure
RestartSec=10s
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
